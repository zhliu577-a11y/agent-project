# DeepSeek 配置模板：复制本文件为 .env，并填入你的真实 API Key
DEEPSEEK_API_KEY=sk-你的key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 超时与重试（可选，默认值如下）
DEEPSEEK_TIMEOUT=60
DEEPSEEK_MAX_RETRIES=3

# OpenAI 配置模板：仅当 AGENT_MODEL=openai（使用 plugins/model/openai 插件）时需要
# OPENAI_API_KEY=sk-你的key
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_TIMEOUT=60
# OPENAI_MAX_RETRIES=3

# 模型插件选择：plugins/model/ 下的插件名（默认 deepseek）
# AGENT_MODEL=deepseek

# 模型路由与资源管理（逗号分隔）
# MODEL_ROUTER=static
# MODEL_FALLBACK=openai
# MODEL_KEEP_WARM=deepseek

# Sub2API Anthropic group（OpenAI Responses 协议）
# AGENT_MODEL=sub2api
# SUB2API_API_KEY=sk-你的token
# 以下值已放在 config/plugins/model/sub2api.json，可用环境变量覆盖：
# SUB2API_BASE_URL=http://172.16.3.6:8589/v1
# SUB2API_MODEL=deepseek-v4-flash
# SUB2API_TIMEOUT=60
# SUB2API_MAX_RETRIES=3
# SUB2API_DISABLE_RESPONSE_STORAGE=true

# 会话存储插件（plugins/session/*，默认 jsonl）与会话标识
SESSION_STORE=jsonl
# 换实现只需改上面一行：SESSION_STORE=inmemory（内存，重启即失）
SESSION_ID=default
# SESSION_DATA_DIR=.sessions
# SESSION_COMPACTION=rolling-summary   # 设为空字符串可关闭持久化压缩

# 长期记忆插件（plugins/memory/*，默认 sqlite 生产后端）
MEMORY_STORE=sqlite
# Optional derived-memory index and policy plugin names.
# MEMORY_INDEX=lexical                     # lexical | recent
# MEMORY_POLICY=default                    # default | strict
# MEMORY_DB_PATH=.memory/memory.db      # sqlite 数据文件
# MEMORY_STORE=jsonl                    # 人眼可读的示例后端（.memory/memory.jsonl）
# MEMORY_DATA_DIR=.memory
# MEMORY_STORE=vector                   # 语义检索后端（需要 embedding 提供方）

# 语义检索（MEMORY_STORE=vector 时生效）
# EMBEDDING_PROVIDER=debug              # debug=离线测试；openai-embedding=真实语义（需 OPENAI_API_KEY）
# MEMORY_VECTOR_DB_PATH=.memory/vector.db
# VECTOR_SIMILARITY_THRESHOLD=0.2
# VECTOR_TOP_K=3
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# CONTEXT_MAX_TOKENS=20000
# CONTEXT_STRATEGY=memory-tail-window    # memory-tail-window | tail-window | summary-window

# Skill 宿主预载与内容预算（覆盖 config/skill.json）
# SKILL_PRELOAD=code-review,commit-message
# SKILL_MAX_CONTENT_BYTES=262144
# SKILL_MAX_PRELOAD_BYTES=524288
# SKILL_MAX_RESOURCES=32
# SKILL_MAX_RESOURCE_BYTES=262144
# SKILL_MAX_RESOURCE_TOTAL_BYTES=1048576

# 事件总线日志：设置后把所有事件写成 JSONL（时间线/调试用）
# EVENT_LOG=.events/events.jsonl

# Event transport implementation: plugins/event_transports/<name>
# EVENT_TRANSPORT=in-process
# Subscriber timeout is owned by EventGateway, not by the transport.
# EVENT_HANDLER_TIMEOUT=5

MCP_CONNECT_TIMEOUT=20
MCP_CALL_TIMEOUT=30
# 启动时主动连接的 MCP 插件名，逗号分隔；留空表示不预加载
# MCP_PRELOAD=time,math
