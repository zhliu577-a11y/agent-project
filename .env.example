# DeepSeek 配置模板：复制本文件为 .env，并填入你的真实 API Key
DEEPSEEK_API_KEY=sk-你的key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 超时与重试（可选，默认值如下）
DEEPSEEK_TIMEOUT=60
DEEPSEEK_MAX_RETRIES=3

# OpenAI 配置模板：仅当 AGENT_MODEL=openai（使用 plugins/model/openai 插件）时需要
# OPENAI_API_KEY=sk-你的key
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_TIMEOUT=60
# OPENAI_MAX_RETRIES=3

# 模型插件选择：plugins/model/ 下的插件名（默认 deepseek）
# AGENT_MODEL=deepseek

# 会话存储插件（plugins/session/*，默认 jsonl）与会话标识
SESSION_STORE=jsonl
# 换实现只需改上面一行：SESSION_STORE=inmemory（内存，重启即失）
SESSION_ID=default
# SESSION_DATA_DIR=.sessions

# 长期记忆插件（plugins/memory/*，默认 sqlite 生产后端）
MEMORY_STORE=sqlite
# MEMORY_DB_PATH=.memory/memory.db      # sqlite 数据文件
# MEMORY_STORE=jsonl                    # 人眼可读的示例后端（.memory/memory.jsonl）
# MEMORY_DATA_DIR=.memory
# MEMORY_STORE=vector                   # 语义检索后端（需要 embedding 提供方）

# 语义检索（MEMORY_STORE=vector 时生效）
# EMBEDDING_PROVIDER=debug              # debug=离线测试；openai-embedding=真实语义（需 OPENAI_API_KEY）
# MEMORY_VECTOR_DB_PATH=.memory/vector.db
# VECTOR_SIMILARITY_THRESHOLD=0.2
# VECTOR_TOP_K=3
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# CONTEXT_MAX_TOKENS=20000

# FastAPI 监听地址（python -m api.main）
# API_HOST=127.0.0.1
# API_PORT=8000

MCP_CONNECT_TIMEOUT=20
MCP_CALL_TIMEOUT=30
