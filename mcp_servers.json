{
  "plugins": [
    {
      "name": "time",
      "description": "查询指定时区的当前时间",
      "enabled": true,
      "mcp": {
        "command": "python",
        "args": ["mcp_servers/time_server.py"]
      }
    },
    {
      "name": "math",
      "description": "安全计算数学表达式",
      "enabled": true,
      "mcp": {
        "command": "python",
        "args": ["mcp_servers/math_server.py"]
      }
    },
    {
      "name": "filesystem",
      "description": "读写本地文件（含写入、编辑、移动等危险操作，会请求用户确认）",
      "enabled": true,
      "mcp": {
        "command": "cmd.exe",
        "args": [
          "/c",
          "npx",
          "-y",
          "@modelcontextprotocol/server-filesystem",
          "E:/documents/learning/Agent/demo_files"
        ]
      }
    }
  ]
}
