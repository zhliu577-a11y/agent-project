{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/harness/plugin-manifest.schema.json",
  "title": "Harness plugin manifest",
  "description": "Versioned manifest for one capability or one multi-capability plugin package.",
  "oneOf": [
    {
      "$ref": "#/$defs/singlePlugin"
    },
    {
      "$ref": "#/$defs/pluginPackage"
    }
  ],
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "protocolVersion": {
      "type": "integer",
      "enum": [
        1,
        2
      ]
    },
    "capabilityKinds": {
      "type": "string",
      "enum": [
        "hook",
        "mcp",
        "tool",
        "model",
        "model-router",
        "context",
        "compaction",
        "skill",
        "session",
        "memory",
        "memory-index",
        "memory-retriever",
        "memory-policy",
        "memory-extractor",
        "embedding",
        "listener",
        "event-transport"
      ]
    },
    "requirement": {
      "type": "object",
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/capabilityKinds"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "contract": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*\\.v[0-9]+$"
        },
        "required": {
          "type": "boolean",
          "default": true
        },
        "inject": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        }
      }
    },
    "modelMetadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "roles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "contextWindow": {
          "type": "integer",
          "minimum": 1
        },
        "supportsTools": {
          "type": "boolean"
        },
        "supportsStreaming": {
          "type": "boolean"
        },
        "costTier": {
          "type": "string"
        },
        "latencyTier": {
          "type": "string"
        }
      }
    },
    "skillResource": {
      "type": "object",
      "required": [
        "path"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Path relative to the plugin directory."
        },
        "description": {
          "type": "string"
        }
      }
    },
    "skillEntry": {
      "type": "object",
      "required": [
        "content"
      ],
      "additionalProperties": false,
      "properties": {
        "content": {
          "type": "string",
          "minLength": 1,
          "description": "Path to the main Skill document, relative to the plugin directory."
        },
        "preload": {
          "type": "boolean",
          "description": "Deprecated compatibility field. Host preload is selected in config/skill.json."
        },
        "resources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/skillResource"
          }
        },
        "when_to_use": {
          "type": "string"
        },
        "whenToUse": {
          "type": "string"
        },
        "tags": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            }
          ]
        },
        "compatibility": {
          "type": "string"
        },
        "license": {
          "type": "string"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "listing": {
          "type": "string",
          "enum": [
            "full",
            "name-only"
          ]
        },
        "name_only": {
          "type": "boolean"
        },
        "nameOnly": {
          "type": "boolean"
        },
        "import_frontmatter": {
          "type": "boolean"
        },
        "importFrontmatter": {
          "type": "boolean"
        }
      }
    },
    "singlePlugin": {
      "type": "object",
      "required": [
        "apiVersion",
        "name",
        "type",
        "version",
        "protocolVersion",
        "contract",
        "entry"
      ],
      "additionalProperties": true,
      "properties": {
        "apiVersion": {
          "type": "string",
          "const": "1"
        },
        "protocolVersion": {
          "$ref": "#/$defs/protocolVersion"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "type": {
          "$ref": "#/$defs/capabilityKinds"
        },
        "version": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "contract": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*\\.v[0-9]+$"
        },
        "entry": {
          "type": "object"
        },
        "priority": {
          "type": "integer"
        },
        "model": {
          "$ref": "#/$defs/modelMetadata"
        },
        "requires": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/requirement"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "skill"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "entry": {
                "$ref": "#/$defs/skillEntry"
              }
            }
          }
        },
        {
          "if": {
            "not": {
              "properties": {
                "type": {
                  "const": "skill"
                }
              },
              "required": [
                "type"
              ]
            }
          },
          "then": {
            "properties": {
              "protocolVersion": {
                "const": 1
              }
            }
          }
        }
      ]
    },
    "pluginPackage": {
      "type": "object",
      "required": [
        "apiVersion",
        "name",
        "version",
        "protocolVersion",
        "contributes"
      ],
      "additionalProperties": true,
      "properties": {
        "apiVersion": {
          "type": "string",
          "const": "1"
        },
        "protocolVersion": {
          "const": 1
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "version": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "contributes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "kind",
              "contract",
              "entry"
            ],
            "additionalProperties": true,
            "properties": {
              "id": {
                "$ref": "#/$defs/name"
              },
              "kind": {
                "$ref": "#/$defs/capabilityKinds"
              },
              "protocolVersion": {
                "$ref": "#/$defs/protocolVersion"
              },
              "contract": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]*\\.v[0-9]+$"
              },
              "entry": {
                "type": "object"
              },
              "description": {
                "type": "string"
              },
              "priority": {
                "type": "integer"
              },
              "model": {
                "$ref": "#/$defs/modelMetadata"
              },
              "requires": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/requirement"
                }
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "skill"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              "then": {
                "properties": {
                  "entry": {
                    "$ref": "#/$defs/skillEntry"
                  }
                }
              }
            }
          ]
        }
      }
    }
  }
}
